{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-prelude-no-invalid": [
      true,
      {
        "ignoreAtRules": ["apply"]
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "extends",
          "tailwind",
          "screen",
          "plugin",
          "source",
          "custom-variant",
          "theme"
        ]
      }
    ]
  }
}
